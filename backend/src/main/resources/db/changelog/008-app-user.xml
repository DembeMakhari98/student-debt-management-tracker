<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <!-- The people who can sign in to the tracker (JWT login). Roles: OFFICER, MANAGER, ADMIN. -->
    <changeSet id="008-01-create-app-user" author="student-debt-tracker">
        <createTable tableName="app_user">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="varchar(60)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_app_user_username"/>
            </column>
            <column name="password_hash" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="team" type="varchar(40)"/>
            <column name="role" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <!-- Links a login to the officer ids the frontend assigns cases to (frontend/src/app/core/officers.ts). -->
            <column name="officer_key" type="varchar(60)"/>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

