<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <!--
        Case ownership (issue #55). A debtor is assigned to one officer by app_user.officer_key; the
        case's team is the assigned officer's app_user.team, so reassigning a case (issue #56) only
        changes this one column. Null means unassigned (e.g. a student first seen by the nightly extract).
    -->
    <changeSet id="010-01-add-debtor-assigned-officer" author="student-debt-tracker">
        <addColumn tableName="debtor">
            <column name="assigned_officer" type="varchar(60)"/>
        </addColumn>
        <createIndex tableName="debtor" indexName="ix_debtor_assigned_officer">
            <column name="assigned_officer"/>
        </createIndex>
    </changeSet>

    <!--
        Demo caseload: the same round-robin over the six demo officers as the Angular mock data
        (frontend/src/app/core/mock-data.ts). Skipped in prod along with the demo users (008-02).
    -->
