            <column name="ageing_60" valueNumeric="10000"/><column name="ageing_90" valueNumeric="10000"/><column name="ageing_120" valueNumeric="0"/>
            <column name="assigned_officer" value="nomsa-mahlangu"/>
        </insert>

        <!-- Rule 3, uncapped: 40% of R10 000 is R4 000. -->
