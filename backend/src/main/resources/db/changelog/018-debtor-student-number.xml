    <!--
        The student's 9-digit Student Number (issue #305), shown next to their name on the Tracker.
        It is text, not a number: a Student Number can start with 0 (e.g. 088002xxx) and every
        digit must be kept. It belongs to the student, not the financial year, so every debtor row
        of the same student_id carries the same number.

        Nullable because ITS Integrator's real Student Records feed is not wired up yet (issue #1);
        the seed rows below give every seeded student a valid number.
    -->
    <changeSet id="018-01-add-debtor-student-number" author="student-debt-tracker">
        <addColumn tableName="debtor">
            <column name="student_number" type="varchar(9)"/>
        </addColumn>
    </changeSet>

